<jasperReport name="separacaodecarga" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="57e4fc6b-b464-4850-b168-25ecc420eb54">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="VERDU_ERP"/>
	<parameter name="ROTA_ID" class="java.lang.Long"/>
	<query language="SQL"><![CDATA[SELECT 
    lr.nome_rota AS rota,
    lv.modelo as veiculo,
    lv.placa,
    lm.nome AS motorista,
    cc.nome_fantasia AS cliente,
    co.numero_ov as OV,
    cp.nome as produto ,
    cu.sigla ,
    ci.quantidade,
    '' as separado,
    co.data_entrega,
    COALESCE(CEIL(ci.quantidade::numeric / NULLIF(cp.qtd_porcaixa_saida, 0)), 0) AS qtd_caixa
FROM lo_rotas lr
LEFT JOIN lo_veiculos lv ON lv.id = lr.veiculo_id 
LEFT JOIN lo_motorista lm ON lm.id = lr.motorista_id
LEFT JOIN cp_cliente cc ON cc.rota_id = lr.id
inner join cp_ordemvenda co on co.cliente_id =cc.id
left join cp_itemov ci on ci.ordem_venda_id = co.id 
left outer join cp_produtos cp on cp.id=ci.produto_id 
left outer join cp_unidademedida cu on cu.id=ci.unidade_medida_id 
where lr.id=$P{ROTA_ID}
ORDER BY lr.id, cc.nome_fantasia;
]]></query>
