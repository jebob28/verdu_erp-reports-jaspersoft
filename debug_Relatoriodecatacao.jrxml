<jasperReport name="Relatoriodecatacao" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="126167c8-ebef-473b-89b4-ab87e1cdb6d9">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="VERDU_ERP"/>
	<dataset name="FORNE" uuid="e43eb431-253c-4314-b1a9-4f84c73527fa">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<parameter name="catacao" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT cc.bairro_catacao,
	lm.nome as motorista,
	lv.modelo,
	lv.placa,
	cf.nome_fantasia,
	cf.endereco,
	coi.ordemcompra_id AS oc,
	cp.nome as produto,
	cu.sigla,
	coi.quantidade
FROM ct_catacao cc
	join lo_motorista lm ON 
	 lm.id = cc.motorista_id 
	left outer join lo_veiculos lv ON 
	 lv.id = cc.veiculo_id 
	left outer join ct_catacao_fornecedor ccf ON 
	 ccf.catacao_id = cc.id 
	left outer join cm_fornecedores cf ON 
	 cf.id = ccf.fornecedor_id 
	left outer join cm_ordemcompra co ON 
	 co.fornecedor_id = cf.id 
	left outer join cm_ordemcompras_itens coi ON 
	 coi.ordemcompra_id = co.id 
	left outer join cp_produtos cp ON 
	 cp.id = coi.produto_id 
	left outer join cp_unidademedida cu ON 
	 cu.id = coi.unidademedida_id 
WHERE 
	 co.status_id = 1 
	 AND cc.id = $P{catacao}]]></query>
