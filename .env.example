# Jaspersoft Reports Configuration
APP_NAME=verdu_erp-reports-jaspersoft
APP_PORT=8080

# Jaspersoft Configuration
JASPER_SERVER_URL=http://localhost:8080/jasperserver
JASPER_ADMIN_USER=jasperadmin
JASPER_ADMIN_PASSWORD=jasperadmin
JASPER_ORGANIZATION=organization_1

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jasperserver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Jaspersoft Database
JASPER_DB_HOST=postgres
JASPER_DB_PORT=5432
JASPER_DB_NAME=jasperserver
JASPER_DB_USER=postgres
JASPER_DB_PASSWORD=postgres123

# Application Database
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_NAME=verdu_erp_reports
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres123

# Security
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=*

# Report Configuration
REPORT_OUTPUT_DIR=/app/reports/output
REPORT_TEMPLATE_DIR=/app/reports/templates
REPORT_LOGO_PATH=/app/reports/img/logo.png

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/jaspersoft.log

# Performance
MAX_CONCURRENT_REPORTS=5
REPORT_TIMEOUT=300000

# Email Configuration (for scheduled reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@verdu.com.br